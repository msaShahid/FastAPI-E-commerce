# Copy this file to .env and fill in real values.
ENVIRONMENT=development
DATABASE_URL=

# python -c "import secrets; print(secrets.token_hex(32))"
jwt_secret=your_generated_value_here

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Minutes a checkout order can sit unpaid before scripts/cancel_stale_orders.py
# cancels it and releases its stock back to inventory. Optional -- defaults to 30.
PENDING_ORDER_TIMEOUT_MINUTES=30

# Exact origin(s) allowed to call this API with credentials (cookies /
# Authorization headers) from a browser. MUST be a JSON array, even for
# one origin -- a comma-separated string will fail to parse at startup.
# MUST NOT contain "*" -- see app/core/config.py for why.
CORS_ORIGINS=["http://localhost:3000"]

# --- Postgres credentials, read by docker-compose.yml for the `db` and
# `test_db` services (NOT read by the app itself -- the app only uses
# DATABASE_URL above, which must be kept in sync with these). ---
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=shop_db

TEST_POSTGRES_USER=test_user
TEST_POSTGRES_PASSWORD=your_test_db_password
TEST_POSTGRES_DB=shop_test_db

# Read directly by the app (app/core/rate_limit.py) as the shared
# storage backend for rate-limit counters across workers/replicas.
REDIS_URL=redis://redis:6379/0

# --- Database connection pool (all optional; the values shown are the defaults) ---
# These limits are PER API PROCESS. The database can see up to
#   (number of processes) x (DB_POOL_SIZE + DB_MAX_OVERFLOW)
# connections in total, which must stay below Postgres's max_connections.
# See docs/connection-pool.md.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=10        # seconds to wait for a free connection before answering 503
# DB_POOL_RECYCLE=1800      # replace connections older than this many seconds (-1 = never)
# DB_POOL_PRE_PING=true     # test a connection before using it
# Only if DATABASE_URL goes through a transaction-mode pooler (PgBouncer, or a
# provider's "-pooler" endpoint) WITHOUT prepared-statement support, and you see
# 'prepared statement "__asyncpg_stmt_..." does not exist' errors:
# DB_DISABLE_PREPARED_STATEMENTS=false

# --- Response cache (all optional; the values shown are the defaults) ---
# Caches the public category and product lists in Redis (REDIS_URL above).
# See docs/caching.md.
# CACHE_ENABLED=true
# CACHE_KEY_PREFIX=shop
# CACHE_TTL_CATEGORIES_SECONDS=300
# CACHE_TTL_PRODUCTS_SECONDS=60
# CACHE_REDIS_TIMEOUT_SECONDS=0.25
# CACHE_FAILURE_COOLDOWN_SECONDS=5
