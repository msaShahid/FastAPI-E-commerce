# ============================================================
# Application
# ============================================================
ENVIRONMENT=development

# The password here MUST equal POSTGRES_PASSWORD below.
# URL-encode special characters (@ -> %40, / -> %2F, # -> %23, % -> %25),
# or use letters and digits only. Hostname "db" is the compose service.
DATABASE_URL=postgresql+asyncpg://your_db_user:REPLACE_WITH_A_STRONG_DB_PASSWORD@db:5432/ecom_db

# Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
# The app does not reject placeholders yet: replace this before running.
jwt_secret=REPLACE_WITH_GENERATED_SECRET

# ============================================================
# Stripe (test keys only: payments are still USD-only in the code)
# ============================================================
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_STRIPE_TEST_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_WEBHOOK_SECRET

# ============================================================
# Checkout
# ============================================================
PENDING_ORDER_TIMEOUT_MINUTES=30

# Shipping & tax (REQUIRED to enable checkout)
# Leave these three lines COMMENTED OUT until you have approved values:
# checkout then answers HTTP 503. Do not leave a variable set but empty,
# which stops the app at startup. Amounts are in minor units (paise);
# the names still say CENTS. Never use a tax rate that has not been approved
# by the owner and a qualified tax professional.
# FLAT_SHIPPING_CENTS=
# TAX_RATE_PERCENT=
# FREE_SHIPPING_THRESHOLD_CENTS=

# ============================================================
# CORS (must be a JSON array, no "*")
# ============================================================
CORS_ORIGINS=["http://localhost:3000"]

# ============================================================
# Main PostgreSQL database (Docker Compose service: db)
# ============================================================
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_DB_PASSWORD
POSTGRES_DB=ecom_db

# ============================================================
# Test PostgreSQL database (Docker Compose service: test_db)
# ============================================================
TEST_POSTGRES_USER=test_user
TEST_POSTGRES_PASSWORD=REPLACE_WITH_A_DIFFERENT_STRONG_PASSWORD
TEST_POSTGRES_DB=ecom_test_db

# Used by pytest inside the api container. Password MUST equal
# TEST_POSTGRES_PASSWORD. Without this, tests fall back to a built-in
# default that does not match the credentials above.
TEST_DATABASE_URL=postgresql+asyncpg://test_user:REPLACE_WITH_A_DIFFERENT_STRONG_PASSWORD@test_db:5432/ecom_test_db

# ============================================================
# Redis (Docker Compose service: redis)
# ============================================================
REDIS_URL=redis://redis:6379/0

# ============================================================
# Database connection pool (values are per API process)
# ============================================================
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# Enable only if your transaction-mode database pooler requires it.
# DB_DISABLE_PREPARED_STATEMENTS=false

# ============================================================
# Response cache
# ============================================================
CACHE_ENABLED=true
CACHE_KEY_PREFIX=shop
CACHE_TTL_CATEGORIES_SECONDS=300
CACHE_TTL_PRODUCTS_SECONDS=60
CACHE_REDIS_TIMEOUT_SECONDS=0.25
CACHE_FAILURE_COOLDOWN_SECONDS=5

# ============================================================
# Background jobs
# ============================================================
JOBS_EMBEDDED_WORKER=false
JOBS_CONCURRENCY=2
JOBS_POLL_INTERVAL_SECONDS=1
JOBS_DEFAULT_MAX_ATTEMPTS=5
JOBS_JOB_TIMEOUT_SECONDS=60
JOBS_LOCK_SECONDS=300
JOBS_RETRY_BASE_SECONDS=30
JOBS_RETRY_MAX_SECONDS=3600

# ============================================================
# Logging
# ============================================================
LOG_FORMAT=json
LOG_LEVEL=INFO