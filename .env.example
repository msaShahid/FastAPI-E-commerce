# Copy this file to .env and fill in real values.
ENVIRONMENT=development
DATABASE_URL=

# python -c "import secrets; print(secrets.token_hex(32))"
jwt_secret=your_generated_value_here

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Minutes a checkout order can sit unpaid before scripts/cancel_stale_orders.py
# cancels it and releases its stock back to inventory. Optional -- defaults to 30.
PENDING_ORDER_TIMEOUT_MINUTES=30

# Exact origin(s) allowed to call this API with credentials (cookies /
# Authorization headers) from a browser. MUST be a JSON array, even for
# one origin -- a comma-separated string will fail to parse at startup.
# MUST NOT contain "*" -- see app/core/config.py for why.
CORS_ORIGINS=["http://localhost:3000"]

# --- Postgres credentials, read by docker-compose.yml for the `db` and
# `test_db` services (NOT read by the app itself -- the app only uses
# DATABASE_URL above, which must be kept in sync with these). ---
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=shop_db

TEST_POSTGRES_USER=test_user
TEST_POSTGRES_PASSWORD=your_test_db_password
TEST_POSTGRES_DB=shop_test_db

# Read directly by the app (app/core/rate_limit.py) as the shared
# storage backend for rate-limit counters across workers/replicas.
REDIS_URL=redis://redis:6379/0

# Log every SQL statement with its bound parameters (local debugging only; never in a shared or production environment).
# DB_ECHO=false

# --- Email (development): emails are written to the log, including the links, so you can click them from `docker compose logs` ---
# EMAIL_BACKEND=log
# FRONTEND_BASE_URL=http://localhost:3000
# To test real delivery, use a catch-all dev inbox (Mailpit/MailHog) or your provider's SMTP: EMAIL_BACKEND=smtp, SMTP_HOST, EMAIL_FROM ...

# --- Database connection pool (all optional; the values shown are the defaults) ---
# These limits are PER API PROCESS. The database can see up to
#   (number of processes) x (DB_POOL_SIZE + DB_MAX_OVERFLOW)
# connections in total, which must stay below Postgres's max_connections.
# See docs/connection-pool.md.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=10        # seconds to wait for a free connection before answering 503
# DB_POOL_RECYCLE=1800      # replace connections older than this many seconds (-1 = never)
# DB_POOL_PRE_PING=true     # test a connection before using it
# Only if DATABASE_URL goes through a transaction-mode pooler (PgBouncer, or a
# provider's "-pooler" endpoint) WITHOUT prepared-statement support, and you see
# 'prepared statement "__asyncpg_stmt_..." does not exist' errors:
# DB_DISABLE_PREPARED_STATEMENTS=false

# --- Response cache (all optional; the values shown are the defaults) ---
# Caches the public category and product lists in Redis (REDIS_URL above).
# See docs/caching.md.
# CACHE_ENABLED=true
# CACHE_KEY_PREFIX=shop
# CACHE_TTL_CATEGORIES_SECONDS=300
# CACHE_TTL_PRODUCTS_SECONDS=60
# CACHE_REDIS_TIMEOUT_SECONDS=0.25
# CACHE_FAILURE_COOLDOWN_SECONDS=5

# --- Background jobs (all optional; the values shown are the defaults) ---
# See docs/background-jobs.md. Run the worker with: python -m scripts.run_worker
# JOBS_EMBEDDED_WORKER=false       # true = run the worker inside the API process
# JOBS_CONCURRENCY=2
# JOBS_POLL_INTERVAL_SECONDS=1
# JOBS_DEFAULT_MAX_ATTEMPTS=5
# JOBS_JOB_TIMEOUT_SECONDS=60
# JOBS_LOCK_SECONDS=300            # must be longer than JOBS_JOB_TIMEOUT_SECONDS
# JOBS_RETRY_BASE_SECONDS=30
# JOBS_RETRY_MAX_SECONDS=3600

# --- Checkout shipping & tax (REQUIRED to enable checkout) ---
# Unset by default: checkout answers HTTP 503 until BOTH of these are set.
# Never set a tax rate that has not been approved by the owner and a qualified
# tax professional. Amounts are in minor units (paise). 0 is allowed but must be deliberate.
# FLAT_SHIPPING_CENTS=
# TAX_RATE_PERCENT=
# FREE_SHIPPING_THRESHOLD_CENTS=     # optional; unset/0 = no free shipping
# FREE_SHIPPING_THRESHOLD_BASIS=subtotal   # REQUIRED whenever a threshold is set (app refuses to start otherwise)

# --- GST master data (admin API under /api/v1/admin/tax) ---
# Default false: a record must be approved by a different admin than its creator.
# Single-admin businesses may set true; self-approval then needs a written note
# and is flagged in the audit log. It is NOT an independent control.
# TAX_MASTER_ALLOW_SELF_APPROVAL=false

# Default false (pre-GST behaviour). When true, a product must point at an APPROVED tax
# classification to be activated or ordered (checkout answers 422 product_tax_unassigned).
# Keep false until the GST calculation phase; see docs/STATUS.md.
# TAX_CLASSIFICATION_REQUIRED=false

# The future GST engine. Keep false: it only checks readiness and then refuses (503
# tax_engine_not_implemented); it never produces a tax amount.
# TAX_CALCULATION_ENABLED=false

# A live Stripe key (sk_live_/rk_live_) is refused unless this is true. Keep false until the
# payment currency (INR), late-payment and refund paths are finished.
# LIVE_PAYMENTS_ENABLED=false

# Currencies this deployment's Stripe account may charge (comma separated, e.g. "inr" or
# "usd,eur"). EMPTY = payments are refused. Confirm in YOUR Stripe account which currencies it can
# charge; only currencies verified by the platform are accepted (usd, inr, eur, gbp, jpy).
# The STORE currency itself is not an environment variable: an administrator sets it once with
# PUT /api/v1/store/currency, before the first order (it is locked after that).
# PAYMENT_CURRENCIES_ENABLED=

# The currency a NEW store starts with (no configured currency and no orders yet). INR by product decision, but
# only a default: an admin can choose another before the first order (PUT /api/v1/store/currency), and once a
# store has one it never changes silently. A store that already has orders must choose explicitly.
# DEFAULT_STORE_CURRENCY=inr

# Webhook events that arrive BEFORE their payment record exists are kept (identifiers only, never the payload) and
# retried by the worker within bounds: every INTERVAL seconds (0 disables recovery), at most MAX_ATTEMPTS times, only for
# WINDOW minutes. After that they expire and the reconciliation record stays for a human.
# WEBHOOK_RECOVERY_INTERVAL_SECONDS=60
# WEBHOOK_RECOVERY_WINDOW_MINUTES=60
# WEBHOOK_RECOVERY_MAX_ATTEMPTS=5

# --- Order / payment lifecycle (the WORKER must be running: `docker compose up -d worker`) ---
# Unpaid orders older than this are expired by the worker (payment intent cancelled, stock restored).
# PENDING_ORDER_TIMEOUT_MINUTES=30
# How often the worker looks for stale orders. 0 disables the scheduler (nothing then expires orders).
# ORDER_EXPIRY_SWEEP_INTERVAL_SECONDS=60
# Longest we wait for one Stripe call; on timeout the outcome is UNKNOWN and is reconciled, never assumed.
# STRIPE_TIMEOUT_SECONDS=15
# After this many failed attempts to learn a refund's outcome it becomes `uncertain` (needs a human).
# REFUND_MAX_ATTEMPTS=3

# --- Logging ---
# json = one JSON object per line (for anywhere logs are collected);
# text = readable lines for local development.
LOG_FORMAT=json
LOG_LEVEL=INFO

# --- Payment provider administration (Phase 2.10) ---
# Key used to ENCRYPT provider credentials stored through the admin API (Fernet key). Unset = credentials cannot be stored (no plaintext
# fallback). Keep it OUT of git and OUT of the database; inject it from a secrets manager in production. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# PROVIDER_SECRETS_KEY=
# PROVIDER_SECRETS_KEY_ID=k1
# When rotating the master key keep the old one here so existing records still decrypt ("id:key,id:key"):
# PROVIDER_SECRETS_PREVIOUS_KEYS=
