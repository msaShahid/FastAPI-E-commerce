# Copy to .env.production (never commit it) and replace EVERY value. In production the application REFUSES TO START while
# JWT_SECRET, STRIPE_SECRET_KEY or STRIPE_WEBHOOK_SECRET are placeholders, so an unedited copy fails closed.
ENVIRONMENT=production
LOG_FORMAT=json
LOG_LEVEL=INFO

# The password in DATABASE_URL must equal POSTGRES_PASSWORD (the db service reads POSTGRES_*, the app reads DATABASE_URL).
POSTGRES_USER=CHANGE_ME_db_user
POSTGRES_PASSWORD=CHANGE_ME_generate_a_long_random_password
POSTGRES_DB=ecom_db
DATABASE_URL=postgresql+asyncpg://CHANGE_ME_db_user:CHANGE_ME_generate_a_long_random_password@db:5432/ecom_db
REDIS_URL=redis://redis:6379/0

# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_generate_with_secrets_token_hex_32
CORS_ORIGINS=["https://shop.example.com"]

# The address of your reverse proxy: uvicorn only trusts X-Forwarded-For from it (client IPs, rate limiting).
FORWARDED_ALLOW_IPS=CHANGE_ME_proxy_ip

# Per-client rate limits on the money-moving routes (login/registration/refresh keep fixed limits). "<count>/<second|minute|hour|day>".
# RATE_LIMIT_CHECKOUT=10/minute
# RATE_LIMIT_PAYMENT=15/minute
# RATE_LIMIT_CART=60/minute

# Where the STOREFRONT lives (required in production, must be https): emailed links point at it, e.g. <this>/reset-password?token=...
FRONTEND_BASE_URL=https://CHANGE_ME_shop.example.com

# Email. EMAIL_BACKEND=log delivers nothing (password-reset links included). Use smtp with any provider's SMTP credentials
# (Amazon SES, Zoho, Brevo, SendGrid, ...). STARTTLS on 587 is the usual choice; use SMTP_SECURITY=ssl with port 465.
EMAIL_BACKEND=smtp
SMTP_HOST=CHANGE_ME_smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
EMAIL_FROM=orders@CHANGE_ME.example.com
EMAIL_FROM_NAME=Your Store
STORE_NAME=Your Store

# The interactive API docs (/docs, /redoc, /openapi.json) are OFF in production by default. Set true only if you accept that
# they describe your whole admin API to anyone who can reach it.
# API_DOCS_ENABLED=false

# The timezone business reports use for "a day" (an IANA name). Orders are stored in UTC.
# REPORTING_TIMEZONE=Asia/Kolkata

# Largest accepted image upload in bytes (admin-only endpoints).
# MAX_IMAGE_BYTES=5242880

# Stripe: use TEST keys until provider sandbox acceptance is complete. Live payments stay disabled.
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
LIVE_PAYMENTS_ENABLED=false
PAYMENT_CURRENCIES_ENABLED=inr
DEFAULT_STORE_CURRENCY=inr

# Credential encryption for provider settings stored through the admin API (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# PROVIDER_SECRETS_KEY=

# Checkout pricing: set deliberately (minor units). LEAVE THE LINES COMMENTED OUT until you have the real values: an unset
# setting means checkout answers 503, but a line with an EMPTY value (`FLAT_SHIPPING_CENTS=`) stops the application starting.
# 0 tax is NOT a rate: use the approved one.
# FLAT_SHIPPING_CENTS=
# TAX_RATE_PERCENT=

PENDING_ORDER_TIMEOUT_MINUTES=30
