# ============================== Environment ==============================
ENVIRONMENT=development
LOG_FORMAT=json
LOG_LEVEL=INFO

# ============================== Database / Redis ==============================

POSTGRES_USER=root
POSTGRES_PASSWORD=********
POSTGRES_DB=ecom_db
DATABASE_URL=postgresql+asyncpg://root:*****@db:5432/ecom_db

# The tests run against this separate database (service test_db): never against ecom_db.
TEST_POSTGRES_USER=test_user
TEST_POSTGRES_PASSWORD=********
TEST_POSTGRES_DB=ecom_test_db
TEST_DATABASE_URL=postgresql+asyncpg://test_user:******@test_db:5432/ecom_test_db

REDIS_URL=redis://redis:6379/0

# The timezone business reports use for "a day" (an IANA name). Orders are stored in UTC.
REPORTING_TIMEZONE=Asia/Kolkata

# Log every SQL statement with its bound parameters (local debugging only; never in a shared or production environment).
# DB_ECHO=false
# API_DOCS_ENABLED=true

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
DB_DISABLE_PREPARED_STATEMENTS=false

# ============================== Security ==============================
# A fresh value for local development (the previous one was pasted into a chat: do not reuse it anywhere). Generate your own for any real
# environment:  docker compose exec api python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# The address of your reverse proxy: uvicorn only trusts X-Forwarded-For from it (client IPs, rate limiting).
# Local development has no proxy, so only this machine is trusted. Set the proxy's address in staging and production.
FORWARDED_ALLOW_IPS=127.0.0.1

# Per-client rate limits on the money-moving routes (login/registration/refresh keep fixed limits). "<count>/<second|minute|hour|day>".
RATE_LIMIT_CHECKOUT=10/minute
RATE_LIMIT_PAYMENT=15/minute
RATE_LIMIT_CART=60/minute

# ============================== Storefront / emails ==============================
# Where the storefront lives: emailed links (password reset, email verification) point at <FRONTEND_BASE_URL>/reset-password?token=...
FRONTEND_BASE_URL=http://localhost:3000
# "log" writes emails to the application log (with the link) instead of sending them. Configure a real email service in the admin panel later.
EMAIL_BACKEND=log

# A replay of a just-rotated refresh token inside this window is a second tab or a retry, not theft (0 = strict)
REFRESH_REUSE_GRACE_SECONDS=10

# Storefront cache hook: the storefront's private address (never routed to the internet) and the shared secret (32+ characters)
FRONTEND_REVALIDATE_URL=http://web:3000/api/bff/revalidate
FRONTEND_REVALIDATE_SECRET=CHANGE_ME_at_least_32_characters

# The storefront does not use /graphql: switch it off unless something else needs it
GRAPHQL_ENABLED=false

# EMAIL_BACKEND=smtp
# EMAIL_FROM=orders@example.com
# SMTP_HOST=CHANGE_ME
# SMTP_USERNAME=CHANGE_ME
# SMTP_PASSWORD=CHANGE_ME


# ============================== Payments ==============================
# Payments are managed in the ADMIN PANEL (GET /api/v1/admin/payments/overview), not here:
#   * demo mode (fake test details, no real money):  POST /api/v1/admin/payments/demo/enable
#   * the client's Stripe / Razorpay credentials, their testing and the switch to live: /api/v1/admin/payment-providers/... and /admin/payments/live/...
# The two Stripe values below are only the legacy environment fallback, used until the first gateway is configured in the admin panel.
# They must be TEST keys (a live key here is always refused). Replace them with your own Stripe test keys, or leave them.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TIMEOUT_SECONDS=15

# Deployment-level KILL SWITCH for live payments. Leave TRUE: live payments are still OFF until an administrator activates them in the
# admin panel. Set false only to forbid live payments on this deployment altogether. (With false, the automated tests of the live-activation
# flow cannot pass.)
LIVE_PAYMENTS_ENABLED=true

# ============================== Tax ==============================
# The GST calculator is off: checkout uses the interim flat rate TAX_RATE_PERCENT below. See docs/GST.md before switching it on.
TAX_CALCULATION_ENABLED=false
TAX_MASTER_ALLOW_SELF_APPROVAL=false

# Currency. A new store starts in INR; an admin can change it before the first order.
DEFAULT_STORE_CURRENCY=inr
# Currencies the environment-configured Stripe may charge (empty = refused). The demo gateway and gateways configured in the admin panel
# are limited to the currencies enabled for them there.
PAYMENT_CURRENCIES_ENABLED=inr

# ============================== Provider credential encryption ==============================
# Needed to store gateway credentials through the admin API, and by the built-in demo gateway.
# A fresh key for local development. If you change it, previously stored credentials can no longer be read (in development: docker compose down -v).
# Generate your own:  docker compose exec api python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROVIDER_SECRETS_KEY=
# PROVIDER_SECRETS_KEY_ID=k1
# PROVIDER_SECRETS_PREVIOUS_KEYS=

# ============================== Checkout: shipping and tax ==============================
# Amounts are in minor units of the store currency (4900 = 49.00 INR).
FLAT_SHIPPING_CENTS=4900
FREE_SHIPPING_THRESHOLD_CENTS=99900
FREE_SHIPPING_THRESHOLD_BASIS=subtotal
# An interim flat rate for LOCAL use (18 = 18%). It is not GST. Replace it with the rate your tax professional approves, or use the GST
# calculator (docs/GST.md), before any real sale. Unset = checkout returns 503.
TAX_RATE_PERCENT=18

# ============================== Customer-facing behaviour ==============================
# Days after delivery (or dispatch) that a customer may ask to return goods. 0 switches returns off.
RETURN_WINDOW_DAYS=7
# "availability": shoppers see in_stock / low_stock / out_of_stock. "exact": they see the number. Administrators always see the number.
PUBLIC_STOCK_VISIBILITY=availability
LOW_STOCK_DISPLAY_THRESHOLD=5

# ============================== Order / payment lifecycle (worker must run) ==============================
PENDING_ORDER_TIMEOUT_MINUTES=30
ORDER_EXPIRY_SWEEP_INTERVAL_SECONDS=60
REFUND_MAX_ATTEMPTS=3
WEBHOOK_RECOVERY_INTERVAL_SECONDS=60
WEBHOOK_RECOVERY_WINDOW_MINUTES=60
WEBHOOK_RECOVERY_MAX_ATTEMPTS=5

# ============================== Cache ==============================
CACHE_ENABLED=true
CACHE_KEY_PREFIX=shop
CACHE_TTL_CATEGORIES_SECONDS=300
CACHE_TTL_PRODUCTS_SECONDS=60
CACHE_REDIS_TIMEOUT_SECONDS=0.25
CACHE_FAILURE_COOLDOWN_SECONDS=5

# ============================== Background jobs ==============================
JOBS_EMBEDDED_WORKER=false
JOBS_CONCURRENCY=2
JOBS_POLL_INTERVAL_SECONDS=1
JOBS_DEFAULT_MAX_ATTEMPTS=5
JOBS_JOB_TIMEOUT_SECONDS=60
JOBS_LOCK_SECONDS=300
JOBS_RETRY_BASE_SECONDS=30
JOBS_RETRY_MAX_SECONDS=3600